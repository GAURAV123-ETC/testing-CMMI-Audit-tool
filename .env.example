# Database Configuration
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cmmi_audit

# Application Configuration
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
APP_TITLE=CMMI V3.0 Audit Platform
ENVIRONMENT=development

# Session Management
SESSION_TIMEOUT_MINUTES=480
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Local application server (run-local.cmd enables reload for development)
APP_HOST=127.0.0.1
APP_PORT=8090
APP_RELOAD=false

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here
TURNSTILE_ENABLED=false

# Microsoft Entra ID
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SENDER_EMAIL=
MICROSOFT_OAUTH_ENABLED=false
MICROSOFT_REDIRECT_URI=http://localhost:8090/auth/microsoft/callback

# CMMI storage and email delivery
MAX_UPLOAD_MB=50
# Opt in only on a hardened Windows host with Microsoft Word installed.
LEGACY_DOC_CONVERSION_ENABLED=false
UPLOAD_DIR=uploads
OUTPUT_DIR=output_file
TEMPLATE_DIR=template_file
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
PUBLIC_BASE_URL=http://localhost:8090
