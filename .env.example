# Database Configuration
DB_USER=cmmi_runtime
DB_PASSWORD=replace-with-a-unique-long-runtime-password
# Used only by the one-shot Compose migration profile; do not use this account
# for the running application.
MIGRATION_DB_USER=cmmi_migrator
MIGRATION_DB_PASSWORD=replace-with-a-separate-long-migration-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-long-migration-password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cmmi_audit

# Application Configuration
SECRET_KEY=replace-with-a-unique-32-character-or-longer-secret
APP_TITLE=CMMI V3.0 Audit Platform
ENVIRONMENT=development

# Session Management
SESSION_TIMEOUT_MINUTES=480
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Local application server (run-local.cmd enables reload for development)
APP_HOST=127.0.0.1
APP_PORT=8090
APP_RELOAD=false
# Set false in production and run `python -m app.db.migrate` with a separate
# migration identity before starting the application.
AUTO_MIGRATE_ON_STARTUP=true

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here
TURNSTILE_ENABLED=false

# Microsoft Entra ID
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SENDER_EMAIL=
MICROSOFT_OAUTH_ENABLED=false
MICROSOFT_REDIRECT_URI=http://localhost:8090/auth/microsoft/callback

# CMMI storage and email delivery
MAX_UPLOAD_MB=50
MAX_DOCUMENT_PAGES=500
MAX_IMAGE_PIXELS=40000000
OCR_TIMEOUT_SECONDS=30
# Opt in only on a hardened Windows host with Microsoft Word installed.
LEGACY_DOC_CONVERSION_ENABLED=false
UPLOAD_DIR=uploads
OUTPUT_DIR=output_file
TEMPLATE_DIR=template_file
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS_MODE=starttls
PUBLIC_BASE_URL=http://localhost:8090

# Comma-separated browser origins allowed to call the API. Leave blank for
# same-origin local development; production must use an HTTPS PUBLIC_BASE_URL.
CORS_ORIGINS=
