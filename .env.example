# Database Configuration
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cmmi_audit

# Application Configuration
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
APP_TITLE=CMMI V3.0 Audit Platform
ENVIRONMENT=development

# Session Management
SESSION_TIMEOUT_MINUTES=480
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Initial administrator (required only for the first empty database startup)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here
TURNSTILE_ENABLED=false

# Microsoft Entra ID
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SENDER_EMAIL=
MICROSOFT_OAUTH_ENABLED=false
MICROSOFT_REDIRECT_URI=http://localhost:8010/auth/microsoft/callback

# CMMI storage and optional integrations
MAX_UPLOAD_MB=50
UPLOAD_DIR=uploads
OUTPUT_DIR=output_file
TEMPLATE_DIR=template_file
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
PUBLIC_BASE_URL=http://localhost:8010
